{
  "version": 1,
  "name": "Torus knot, animated",
  "splats": [{ "src": "knot-clean.sog", "rotation": [0, 0, 180] }],
  "camera": {
    "fov": 50,
    "initial": { "position": [3.2, 1.4, 3.2], "target": [0, 0.1, 0] }
  },
  "controls": { "minDistance": 0.6, "maxDistance": 10, "minPitch": -89, "maxPitch": 20 },
  "background": "#03060b",
  "forces": [
    {
      "name": "Updraft swirl",
      "type": "swirl",
      "position": [0, 0, 0],
      "rotation": [0, 0, 0],
      "radius": 2.4,
      "strength": 5,
      "amount": 0.15,
      "cycle": 7,
      "render": "splats",
      "dotSize": 0.014,
      "tint": 0,
      "noise": 0.07,
      "noiseScale": 1.3,
      "lift": 0.12,
      "pull": 0
    }
  ],
  "animation": {
    "duration": 12,
    "loop": true,
    "autoplay": true,
    "tracks": [
      {
        "target": "camera.position",
        "keys": [
          { "t": 0, "v": [3.2, 1.4, 3.2] },
          { "t": 4, "v": [-3.4, 2.2, 2.4] },
          { "t": 8, "v": [-1.5, 0.8, -4.0] },
          { "t": 12, "v": [3.2, 1.4, 3.2] }
        ]
      },
      { "target": "camera.target", "keys": [{ "t": 0, "v": [0, 0.1, 0] }] },
      {
        "target": "force.0.strength",
        "keys": [
          { "t": 0, "v": 5 },
          { "t": 6, "v": 70 },
          { "t": 12, "v": 5 }
        ]
      },
      {
        "target": "force.0.amount",
        "keys": [
          { "t": 0, "v": 0.15 },
          { "t": 6, "v": 1 },
          { "t": 12, "v": 0.15 }
        ]
      }
    ]
  }
}
